# The runtime image contains no credentials and executes the same autosql CLI
# used locally. BuildKit/buildx selects the matching base image per platform.
FROM golang:1.25.12 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags='-s -w' -o /out/autosql ./cmd/autosql
FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=build /out/autosql /autosql
USER nonroot:nonroot
ENTRYPOINT ["/autosql"]
