{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosql.dev/schemas/output-v1.json",
  "title": "AutoSQL output envelope v1",
  "type": "object",
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": "autosql.output/v1" },
    "command": { "type": "string" },
    "ok": { "type": "boolean" },
    "data": {
      "description": "Command result. migrate status returns manifest_digest, ordered entries, counts, and optional dirty/drift flags. Entry classifications are pending, applied, failed, partial, baseline, checkpoint, drift, or unknown. schema test and migrate test return an ordered suite on success and failure, with counts, case locations and primary/cleanup outcomes, captured input identities and report_errors."
    },
    "error": {
      "type": "object",
      "required": ["kind", "message", "exit_code"],
      "properties": {
        "kind": { "enum": ["internal", "usage", "config", "secret", "validation", "permission", "connection", "migration", "conflict", "timeout", "canceled"] },
        "message": { "type": "string" },
        "field": {
          "type": "string",
          "description": "JSON pointer identifying a configuration field, when available."
        },
        "location": {
          "type": "object",
          "required": ["file", "line", "column", "end_line", "end_column"],
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 },
            "end_column": { "type": "integer", "minimum": 1 }
          }
        },
        "exit_code": { "type": "integer" },
        "status": { "enum": ["planned", "dry_run", "no_op", "success", "refused", "partial_failure", "uncertain"] }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } } }, "then": { "not": { "required": ["error"] } } },
    { "if": { "properties": { "ok": { "const": false } } }, "then": { "required": ["error"] } }
  ],
  "additionalProperties": true
}
